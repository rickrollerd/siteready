<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app is copied to a cloud backup or to a new phone (Android 12 and later; older
     versions follow allowBackup="false" in the manifest). The app keeps the sign-in session, cookies
     and unsaved drafts in its web storage; saved SWMS are on the server, so a new phone signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
