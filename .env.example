# SiteReady environment variables
# Copy this file to .env and change what you need.

# Server port
PORT=3849

# Optional: extra origins allowed to call the API (comma-separated).
# The native app origins (capacitor://localhost, https://localhost) are always allowed.
# ALLOWED_ORIGINS=https://siteready.co.nz

# Optional: rate limits per client address for /api routes
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=600
# RATE_LIMIT_WORD_REQUESTS=300

# Optional: server worker processes (default: one per processor core)
# WEB_CONCURRENCY=4

# Number of proxies in front of the server (Railway: 1). Set 0 if clients connect directly.
# TRUST_PROXY=1

# Accounts (sign-in, saved SWMS, sites, worker sign-on). Railway sets
# DATABASE_URL when a Postgres service is added to the project.
# DATABASE_URL=postgres://user:password@host:5432/railway
# The public address of the app, used in sign-in links, QR codes and Face ID.
# APP_URL=https://siteready.co.nz
# Face ID (passkeys) domain. Defaults to the APP_URL host.
# RP_ID=siteready.co.nz

# Email for sign-in links and review reminders.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=SiteReady <sitereadyaus@gmail.com>
# RATE_LIMIT_EMAIL_REQUESTS=10

# Subscriptions (Stripe). Make a monthly price in the Stripe dashboard and put its id here.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PRICE_LABEL=A$49 a month incl. GST
# PRICE_MONTHLY=49

# Owner's numbers page (/admin.html): emails allowed to see it, comma-separated.
# ADMIN_EMAILS=sitereadyaus@gmail.com
