# SiteReady environment variables
# Copy this file to .env and change what you need.

# Server port
PORT=3849

# Optional: extra origins allowed to call the API (comma-separated).
# The native app origins (capacitor://localhost, https://localhost) are always allowed.
# ALLOWED_ORIGINS=https://siteready.co.nz

# Optional: rate limit for /api routes
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
